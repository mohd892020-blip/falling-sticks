<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and phone-to-phone transfer keep the WebView data, so players keep their progress. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
        <exclude domain="root" path="app_webview/GPUCache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
        <exclude domain="root" path="app_webview/GPUCache/" />
    </device-transfer>
</data-extraction-rules>
