<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode, versionName, minSdk and targetSdk are added by build.py -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.mohd.fallingsticks">
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The game is offline; the WebView still expects this to load its https://appassets... pages reliably. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="Falling Sticks"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
